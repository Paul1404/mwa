# PostgreSQL connection string. Provided automatically by Railway when a
# Postgres service is attached: ${{Postgres.DATABASE_URL}}.
DATABASE_URL=postgres://user:password@localhost:5432/mwa

# 32-byte symmetric key, base64-encoded, used to encrypt SSH private keys
# at rest with AES-256-GCM. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotate by re-encrypting all rows; losing this key makes stored keys unreadable.
ENCRYPTION_KEY=

# Secret used by better-auth to sign session cookies. Any random string >=32 chars.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=

# Public URL of this app. Used by better-auth for cookie scope and callback URLs.
# Example: https://mwa.example.com  (no trailing slash)
BETTER_AUTH_URL=http://localhost:3000

# Set to "false" after the first user is registered to disable public signup.
ALLOW_SIGNUP=true

# Port Railway injects automatically. Locally defaults to 3000.
PORT=3000
